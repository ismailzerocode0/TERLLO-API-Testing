    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// تأكد إن الـ base variables موجودة قبل أي request\r",
          "const requiredVars = [\"Key\", \"token\", \"base_url\"];\r",
          "\r",
          "requiredVars.forEach((key) => {\r",
          "    const value = pm.environment.get(key) || pm.collectionVariables.get(key);\r",
          "    if (!value) {\r",
          "        console.warn(`⚠️ Missing variable: ${key}`);\r",
          "    }\r",
          "});\r",
          "\r",
          "// لو حابب تضيف timestamp لكل request (مفيد في اللوج)\r",
          "pm.collectionVariables.set(\"requestStartTime\", Date.now());"
        ],
        "type": "text/javascript"
      }
