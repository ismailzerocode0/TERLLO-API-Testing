    {
      "listen": "test",
      "script": {
        "exec": [
          "pm.test(\"Response time is less than 1000ms\", function () {\r",
          "pm.expect(pm.response.responseTime).to.be.below(1000);\r",
          "});\r",
          "\r",
          "// 1. كل response لازم يرجع في وقت معقول\r",
          "pm.test(\"[Global] Response time is below 3000ms\", () => {\r",
          "    pm.expect(pm.response.responseTime).to.be.below(3000);\r",
          "});\r",
          "\r",
          "// 2. كل response لازم يكون JSON صحيح (إلا لو كان نص عادي زي \"The requested resource was not found.\")\r",
          "pm.test(\"[Global] Response is valid JSON or plain text\", () => {\r",
          "    try {\r",
          "        pm.response.json();\r",
          "    } catch (e) {\r",
          "        pm.expect(pm.response.text()).to.be.a(\"string\");\r",
          "    }\r",
          "});\r",
          "\r",
          "// 3. لو الـ status كود من فئة 4xx أو 5xx، يبان واضح في الـ console للمتابعة\r",
          "pm.test(\"[Global] Log error responses for review\", () => {\r",
          "    if (pm.response.code >= 400) {\r",
          "        console.error(`❌ ${pm.request.method} ${pm.request.url} → ${pm.response.code}: ${pm.response.text()}`);\r",
          "    }\r",
          "    pm.expect(true).to.be.true; // مجرد تسجيل، مش فشل الـ test\r",
          "});\r",
          "\r",
          "// 4. تأكيد إن الـ Content-Type دايمًا JSON للـ success responses\r",
          "pm.test(\"[Global] Content-Type is application/json on success\", () => {\r",
          "    if (pm.response.code === 200) {\r",
          "        pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
          "    }\r",
          "});\r",
          "\r",
          "// 5. قياس زمن الاستجابة الكلي من بداية الـ pre-request\r",
          "pm.test(\"[Global] Total round-trip logged\", () => {\r",
          "    const start = pm.collectionVariables.get(\"requestStartTime\");\r",
          "    if (start) {\r",
          "        console.log(`⏱ Round-trip: ${Date.now() - start}ms`);\r",
          "    }\r",
          "});"
        ],
        "type": "text/javascript"
      }
